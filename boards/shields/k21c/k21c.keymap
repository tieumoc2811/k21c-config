#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
/ {
  keymap {
    compatible = "zmk,keymap";
    label = "K21C";
    layer0 {
      bindings = <
        &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_ENTER &none &none &none
        &kp KP_N4 &kp KP_N5 &kp KP_N6 &none &none &none &none
        &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_PLUS &none &none &none
        &kp KP_NUMLOCK &kp KP_DIVIDE &kp KP_MULTIPLY &kp KP_MINUS &none &none &none
        &none &kp KP_N0 &kp KP_DOT &none &kp ESC &kp MO 1 &none
        &none &none &none &none &none &none &kp BACKSPACE
        &none &none &none &none &kp TAB &none &none
      >;
    };
    layer1 {
      bindings = <
        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none &none &none
        &trans &trans &trans &none &none &none &none
        &trans &trans &trans &trans &none &none &none
        &trans &trans &trans &trans &none &none &none
        &none &trans &trans &none &trans &trans &none
        &none &none &none &none &none &none &trans
        &none &none &none &none &trans &none &none
      >;
    };
  };
};
